# Plantilla de deploy/.env — variables para Postgres y Caddy en
# docker-compose.prod.yml. Copiar a deploy/.env y completar (no se
# versiona, ver .gitignore).
#
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB deben coincidir exactamente
# con el usuario/clave/nombre de base en la DATABASE_URL de
# backend/.env.prod (host "db", el nombre del servicio de este compose).

POSTGRES_USER=emanuel_obras
POSTGRES_PASSWORD=CAMBIA-ESTA-CLAVE
POSTGRES_DB=emanuel_obras

# Dominio real donde quedará publicado el sistema (ej: obras.miempresa.com).
# Mientras no haya uno, se deja en localhost: Caddy sirve por HTTP local y
# no intenta pedir certificado HTTPS.
DOMAIN=localhost
