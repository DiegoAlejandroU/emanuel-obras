# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/emanuel_obras

# Clave para firmar los JWT — genera una propia, nunca uses este valor ni uno corto.
# Por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Algoritmo de firma del JWT
ALGORITHM=HS256

# Minutos de vigencia del token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dominio permitido para CORS (URL del dashboard)
ALLOWED_ORIGIN=http://localhost:5173

# development | staging | production
ENVIRONMENT=development

# Desviación (fracción, ej. 0.1 = 10%) entre avance real y programado que dispara una alerta
UMBRAL_ALERTA_RETRASO=0.1
