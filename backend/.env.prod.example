# Plantilla del .env de PRODUCCIÓN del backend (backend/.env.prod).
# Copiar a backend/.env.prod y completar — este archivo NO se versiona
# (ver .gitignore). No confundir con backend/.env (desarrollo local).

# "db" es el nombre del servicio de Postgres en docker-compose.prod.yml —
# no "localhost" como en desarrollo. usuario/clave/nombre de base deben
# coincidir con los de deploy/.env (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB).
DATABASE_URL=postgresql://emanuel_obras:CAMBIA-ESTA-CLAVE@db:5432/emanuel_obras

# Genera una propia: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# El dominio real — Caddy sirve el frontend y la API en el mismo origen
# (mismo dominio, / y /api respectivamente), así que esto es más que nada
# una segunda línea de defensa si algo llama a la API desde otro origen.
ALLOWED_ORIGIN=https://TU_DOMINIO

ENVIRONMENT=production
UMBRAL_ALERTA_RETRASO=0.1
